# Copy to smarty.conf and edit for your robot:
#     cp smarty.conf.example smarty.conf
#
# smarty.conf is sourced by smarty.sh; it is plain shell, so quotes matter.

# ---- hosts ---------------------------------------------------------------
# Names from Smarty's cheat sheet. They must resolve (try: ssh mockbot true).
ROBOT_HOST="${ROBOT_HOST:-mockbot}"     # Pi 5: Roomba base + lidar
CAMERA_HOST="${CAMERA_HOST:-marvin}"    # camera Pi
ATLAS_HOST="${ATLAS_HOST:-atlas}"       # ultrasonic / misc Pi

# ---- ROS environment -----------------------------------------------------
# Sourced on every remote host before the command runs.
ROS_SETUP='source /opt/ros/jazzy/setup.bash && source ~/ros2_ws/install/setup.bash'
# Sourced in local (workstation) panes. Often the same, sometimes humble.
LOCAL_ROS_SETUP="${LOCAL_ROS_SETUP:-$ROS_SETUP}"
# Where the workstation's ROS workspace lives (used as each local pane's cwd).
LOCAL_WS="${LOCAL_WS:-$HOME/ros2_ws}"

# ---- map files -----------------------------------------------------------
# Used by the navigation profile and by the map-saver pane.
MAP_FILE="${MAP_FILE:-$HOME/ros2_ws/src/maps/map.yaml}"
MAP_SAVE="${MAP_SAVE:-$HOME/ros2_ws/src/maps/map}"

# ---- commands ------------------------------------------------------------
# Each line is one pane. Edit these to match your robot; the structure stays.
CMD_BASE='ros2 launch create_bringup create_2.launch'
CMD_LIDAR='ros2 launch ldlidar_stl_ros2 ld06.launch.py'
CMD_CAMERA='v4l2-ctl -d /dev/video0 -p 5 && ros2 run v4l2_camera v4l2_camera_node'
CMD_TALKER='ros2 run py_pubsub talker'

CMD_DISPLAY='ros2 launch sam_bot_description display.launch.py'
CMD_SLAM_MAPPING='ros2 launch slam_toolbox online_async_launch.py'
CMD_SLAM_TURTLEBOT='ros2 launch turtlebot4_navigation slam.launch.py sync:=false'
CMD_LOCALIZATION="ros2 launch nav2_bringup localization_launch.py map:=$MAP_FILE"
CMD_NAV2='ros2 launch mockbot_bringup navigation_launch.py'
CMD_RVIZ='ros2 launch nav2_bringup rviz_launch.py'
CMD_TELEOP='ros2 run teleop_twist_keyboard teleop_twist_keyboard'
CMD_MAP_SAVE="ros2 run nav2_map_server map_saver_cli -f $MAP_SAVE --free 0.196 --ros-args -p save_map_timeout:=5000.0"
